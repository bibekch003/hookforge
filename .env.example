# Copy to .env and fill in only what you need. The app runs fully without this file.

# --- optional LLM copy engine ---------------------------------------------
# Any OpenAI-compatible endpoint works (OpenAI, Groq, Together, a local vLLM...).
# Without a key the deterministic offline engine is used and the report says so.
# HOOKFORGE_LLM_API_KEY=
# HOOKFORGE_LLM_BASE_URL=https://api.openai.com/v1
# HOOKFORGE_LLM_MODEL=gpt-4o-mini

# --- runtime paths --------------------------------------------------------
# HOOKFORGE_DATA=./data
# HOOKFORGE_DB=./data/hookforge.db
# HOOKFORGE_MAX_UPLOAD_MB=200

# --- ffmpeg ---------------------------------------------------------------
# Set only if you want a specific build; otherwise system ffmpeg then the
# imageio-ffmpeg static binary is used.
# FFMPEG_BIN=/usr/local/bin/ffmpeg
